      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_cx_total{instance=\"/tick-lb\"}[1m]))",
          "legendFormat": "New Connections {{envoy_cluster_name}}",
          "refId": "A"
        },
        {
