      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_xx{envoy_response_code_class=\"5\",instance=\"/tick-lb\"}[1m]))",
          "legendFormat": "5xx {{envoy_cluster_name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_xx{envoy_response_code_class=\"4\",instance=\"/tick-lb\"}[1m]))",
          "legendFormat": "4xx {{envoy_cluster_name}}",
          "refId": "B"
        }
      ]
    },
    {
