@startuml price_cache_service_sequence
title Price Cache Service & Reference Price Resolution Flow

autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10

box "Inbound Market Data Streams" #LightCyan
participant "Connection Manager (gRPC)" as CM
end box

box "Price Cache Engine (Python Service)" #LightYellow
participant "gRPC Stream Consumer" as GSC
participant "KeyPatternResolver" as KPR
participant "Dual-Bucket RAM (Provider & Symbol)" as RAM
participant "Provider Flush Loop (100ms)" as PFL
participant "Symbol Flush Loop (500ms)" as SFL
end box

box "Redis In-Memory Tier" #LightGreen
participant "Redis In-Memory Store" as Redis
end box

box "Consumers & Trading Cockpit" #LightPink
participant "TradingRedisFacade (Java OPS/OMS)" as TRF
participant "Web App BFF (Node.js)" as BFF
participant "Web Cockpit (Browser UI)" as UI
end box

== Phase 1: High-Frequency Tick Ingestion & Dual-Bucket Buffering ==
CM -> GSC: StreamMarketData bar_proto\n(symbol="AAPL", close=336.87, provider="alpaca")
activate GSC
GSC -> GSC: Extract symbol="AAPL", provider="alpaca" from bar_proto
GSC -> KPR: get_provider_key("alpaca", "AAPL") & get_symbol_key("AAPL")
activate KPR
KPR --> GSC: provider_key="market:last_price:alpaca:AAPL",\nsymbol_key="market:last_price:AAPL"
deactivate KPR

GSC -> RAM: update_price("AAPL", 336.87, "alpaca")
note right of RAM: Sub-nanosecond RAM dual write:\nprovider_bucket["market:last_price:alpaca:AAPL"] = "336.87"\nsymbol_bucket["market:last_price:AAPL"] = "336.87"
deactivate GSC

== Phase 2: Dual Micro-Batch Redis Flush Loops with TTL ==
PFL -> RAM: Lock & drain provider bucket (max_batch=20)
RAM --> PFL: snapshot = {"market:last_price:alpaca:AAPL": "336.87"}
PFL -> Redis: PIPELINE SET market:last_price:alpaca:AAPL "336.87" EX 60
activate Redis
Redis --> PFL: OK (High-frequency provider flush: 100ms, TTL 60s)
deactivate Redis

SFL -> RAM: Lock & drain symbol bucket (max_batch=100)
RAM --> SFL: snapshot = {"market:last_price:AAPL": "336.87"}
SFL -> Redis: PIPELINE SET market:last_price:AAPL "336.87" EX 60
activate Redis
Redis --> SFL: OK (Backup symbol flush: 500ms, TTL 60s)
deactivate Redis

== Phase 3: ADR-005 Price Resolution in Java Services (OPS / OMS) ==
TRF -> TRF: getMarketPrice("alpaca", "AAPL")
activate TRF

TRF -> Redis: GET market:last_price:alpaca:AAPL
activate Redis
Redis --> TRF: "336.87" (Primary provider price match)
deactivate Redis

TRF --> TRF: Return 336.87 (ADR-005 compliant reference price)
deactivate TRF

== Phase 4: BFF Polling & Real-Time Cockpit WebSocket Streaming ==
loop Every 1000ms
    BFF -> Redis: MGET market:last_price:AAPL market:last_price:MSFT
    activate Redis
    Redis --> BFF: ["336.87", "499.06"]
    deactivate Redis
    
    BFF -> UI: ws.send({\n"type": "tick",\n"payload":\n\t{"symbol": "AAPL",\n\t"price": 336.87,\n\t"source": "redis"}})
end

@enduml
