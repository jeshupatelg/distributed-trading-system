# Alpaca Paper Trading API Credentials
# Replace these with your actual Alpaca API credentials for local run
ALPACA_API_KEY=YOUR_ALPACA_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY_HERE

# Kafka Topic Management
# If true, the services will programmatically create required topics on startup if missing.
# If false, the services will raise an error and fail to start if the topics are missing.
KAFKA_AUTO_CREATE_TOPICS=true
